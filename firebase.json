{
  "hosting": {
    "site": "specindex-ai",
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": true,
    "rewrites": [
      {
        "source": "/project/*/",
        "destination": "/project/view/index.html"
      },
      {
        "source": "/project/*",
        "destination": "/project/view/index.html"
      }
    ],
    "redirects": [
      {
        "source": "/projects/:id/",
        "destination": "/project/:id/",
        "type": 301
      },
      {
        "source": "/projects/:id",
        "destination": "/project/:id/",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0"
          }
        ]
      },
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}

# Copy to .env and fill in before running scripts/setup-phase1-gcp.sh
# .env is gitignored — never commit passwords.

SPECINDEX_GCP_PROJECT=specindex-ai
SPECINDEX_GCP_REGION=us-central1
SPECINDEX_DB_INSTANCE=specindex-db
SPECINDEX_DB_NAME=specindex
SPECINDEX_DB_USER=specindex
SPECINDEX_DB_PASSWORD=

# Set automatically after Cloud Run deploy:
# SPECINDEX_API_URL=https://specindex-api-xxxxx-uc.a.run.app

# Vertex AI / Gemini (optional; for scrape/enrichment scripts)
# GOOGLE_CLOUD_PROJECT=specindex-ai
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_GENAI_USE_VERTEXAI=true
# VERTEX_GEMINI_MODEL=gemini-3.6-flash
# Auth: gcloud auth application-default login
#
# Claude on Vertex (Model Garden). Quota often starts at 0 — use Anthropic
# direct until GlobalOnlinePredictionRequests…/anthropic-claude-sonnet is granted.
# VERTEX_CLAUDE_MODEL=claude-sonnet-5
# VERTEX_CLAUDE_LOCATION=global
# VERTEX_CLAUDE_BACKEND=anthropic
# ANTHROPIC_API_KEY=
#
# Vertex AI Agent Platform key
# VERTEX_AGENT_PLATFORM_KEY=
#
# NJ DCA incremental pipeline (Socrata -> Flash -> Sonnet)
# SOCRATA_APP_TOKEN=
# NJ_DCA_FLASH_MODEL=gemini-3.6-flash
# NJ_DCA_SONNET_BACKEND=anthropic
# NJ_DCA_SONNET_MODEL=claude-sonnet-4-20250514
# NJ_DCA_FLASH_BATCH=40
# NJ_DCA_SONNET_BATCH=60
# NJ_DCA_MAX_RETRIES=4
# NJ_DCA_LOOKBACK_DAYS=30
# NJ_DCA_NOTIFY_TO=asif@specindex.ai
# Daily email after cron (reuse Gmail app password from API contact notify):
# EMAIL_SMTP_USERNAME=
# EMAIL_SMTP_PASSWORD=

# Firebase Auth -- replaced Clerk 2026-07-29. Frontend config, safe to bake
# into the static build (Firebase's client config is public by design --
# security relies on backend token verification, not on hiding these).
# Get these from Firebase Console -> Project Settings -> General -> Your
# apps -> Web app (same "specindex-ai" project already used for
# Hosting/Postgres/Vertex -- no new project needed):
# NEXT_PUBLIC_FIREBASE_API_KEY=...
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=specindex-ai.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=specindex-ai
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=specindex-ai.firebasestorage.app
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=...
# NEXT_PUBLIC_FIREBASE_APP_ID=...
#
# Backend (api/main.py) -- just the project id, used as the expected
# audience when verifying a Firebase ID token against Google's public
# certs. No secret/service-account credential needed for verification
# itself:
# FIREBASE_PROJECT_ID=specindex-ai

# Document AI OCR processor id (region: us). OPTIONAL -- extract-document-text.py
# discovers an enabled OCR_PROCESSOR from the project when this is unset. Pin it
# here to be explicit about WHICH processor is used.
#
# This was missing for weeks while the processor existed and was ENABLED, so
# every scanned page was recorded as "skipped_no_docai" -- 471 skipped, 672
# stored near-empty, with no error. Local agency addenda are frequently scanned
# images, so that silence looked exactly like "these documents contain nothing".
# Run `python3 scripts/verify-environment.py` to check.
DOCUMENT_AI_PROCESSOR_ID=

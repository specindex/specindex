# Copy to .env and fill in before running scripts/setup-phase1-gcp.sh
# .env is gitignored — never commit passwords.

SPECINDEX_GCP_PROJECT=specindex-ai
SPECINDEX_GCP_REGION=us-central1
SPECINDEX_DB_INSTANCE=specindex-db
SPECINDEX_DB_NAME=specindex
SPECINDEX_DB_USER=specindex
SPECINDEX_DB_PASSWORD=

# Set automatically after Cloud Run deploy:
# SPECINDEX_API_URL=https://specindex-api-xxxxx-uc.a.run.app

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing -- Jest's coverage output. NOTE the name collision: coverage/docs and
# coverage/data hold the SpecIndex coverage plan and verified source tables, and
# must be versioned. Without these negations `git add coverage/` silently adds
# nothing and the commit lands empty -- which looks exactly like success.
/coverage/*
!/coverage/docs/
!/coverage/data/
!/coverage/test-results/
!/coverage/pull-log/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
.cache/
*.pem
.env
.env*.local

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# firebase
.firebase/
firebase-debug.log
firestore-debug.log

# agent tooling caches (local only). Skills are the exception: a skill that is
# not committed is invisible to every other machine and every future session,
# which defeats the point of having one.
.agents/
.claude/*
!.claude/skills/
skills-lock.json

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.pyc

# large scratch downloads -- e.g. pull-sam-gov-bulk-national.py's 230MB CSV
# cache, exceeds GitHub's 100MB push limit and shouldn't be tracked anyway
data/raw/.sam-gov-bulk-download.csv

# per-run pipeline intermediates (raw/extracted/golden snapshots, one-off
# state-*.json dumps) -- ephemeral, reproducible from source, real output
# lives in data/states/*.json and public/data/national-commercial-projects.json
data/pipeline/

# downloaded source documents (RFPs, EIS reports, etc.) -- large binaries,
# stored in GCS instead of git; see docs/ROADMAP.md
data/documents/

# Gemini discovery chat session history -- working conversation state,
# not corpus data. See scripts/gemini_discovery_chat.py.
data/gemini_sessions/
data/gemini_query_cache/

# Pipeline document output. PDFs live in GCS, never in git -- a spec book is
# 300-1,000+ pages and the repo holds code and source tables only.
*.pdf
specs/
!coverage/docs/*.pdf

# Local pipeline run logs (328K of funnel/ and deep/ output). Not provenance --
# the versioned run evidence is coverage/pull-log/, which is negated above.
# Left untracked, this fires the Stop guard on every session until it is
# ignored, and a guard that cries wolf gets switched off.
/logs/

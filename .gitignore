# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
.cache/
*.pem
.env
.env*.local

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# firebase
.firebase/
firebase-debug.log
firestore-debug.log

# agent tooling caches (local only)
.agents/
.claude/
skills-lock.json

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.pyc

# large scratch downloads -- e.g. pull-sam-gov-bulk-national.py's 230MB CSV
# cache, exceeds GitHub's 100MB push limit and shouldn't be tracked anyway
data/raw/.sam-gov-bulk-download.csv

# per-run pipeline intermediates (raw/extracted/golden snapshots, one-off
# state-*.json dumps) -- ephemeral, reproducible from source, real output
# lives in data/states/*.json and public/data/national-commercial-projects.json
data/pipeline/

# downloaded source documents (RFPs, EIS reports, etc.) -- large binaries,
# stored in GCS instead of git; see docs/ROADMAP.md
data/documents/

# Gemini discovery chat session history -- working conversation state,
# not corpus data. See scripts/gemini_discovery_chat.py.
data/gemini_sessions/
